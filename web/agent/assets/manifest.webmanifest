{
  "id": "/agent/",
  "name": "Nova Agent",
  "short_name": "Nova Agent",
  "description": "The studio's one app: chat, Missions and Quests, with Portal, Calendar, Notes, Index, Observatory and Lossless audio inside it.",
  "start_url": "/agent/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#06040D",
  "theme_color": "#06040D",
  "categories": [
    "productivity",
    "business"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/agent/icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/agent/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/agent/icon-maskable-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/agent/icon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Your quests, hour by hour",
      "url": "/?view=today",
      "icons": [
        {
          "src": "/agent/icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Portal",
      "short_name": "Portal",
      "description": "Enquiries, chats, bookings and alerts",
      "url": "/agent/?open=%2Fportal%2F",
      "icons": [
        {
          "src": "/agent/icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Alerts",
      "short_name": "Alerts",
      "url": "/agent/?open=%2Fportal%2F%3Fview%3Dalerts",
      "icons": [
        {
          "src": "/agent/icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "/agent/?open=%2Fcalendar%2F",
      "icons": [
        {
          "src": "/agent/icon-192.png?v=2",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
