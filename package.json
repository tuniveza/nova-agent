{
  "name": "agent-nova",
  "version": "0.1.0",
  "private": true,
  "description": "Nova Agent: the studio's one app (chat, planner, Portal, Calendar, Notes, Index, Observatory) and its Acuity helper (Novacane Studios)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "login": "HEADLESS=false tsx src/index.ts --manual-login",
    "typecheck": "tsc --noEmit",
    "visualizer": "tsx src/visualizer/server.ts",
    "list": "tsx src/index.ts list",
    "search": "tsx src/index.ts search",
    "book": "tsx src/index.ts book",
    "cancel": "tsx src/index.ts cancel",
    "edit": "tsx src/index.ts edit",
    "healthcheck": "tsx src/index.ts healthcheck",
    "service": "tsx src/visualizer/server.ts",
    "test": "vitest run",
    "observatory:scan": "node scripts/observatory/scan.mjs",
    "observatory:capture": "node scripts/observatory/capture.mjs",
    "observatory:build": "node scripts/observatory/scan.mjs && node scripts/observatory/capture.mjs && node scripts/observatory/scan.mjs",
    "manual": "node scripts/build-status.mjs && node scripts/build-manual.mjs",
    "status": "node scripts/build-status.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.13",
    "node-cron": "^4.6.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
