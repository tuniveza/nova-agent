# Copy this file to .env and fill it in. Never commit .env.

ACUITY_EMAIL=
ACUITY_PASSWORD=
# Admin page used to check the login. Leave blank for the default.
ACUITY_ADMIN_URL=

ANTHROPIC_API_KEY=
# A current Claude model name, e.g. claude-sonnet-5-5
NOVA_MODEL=

# Novabot's worker: Nova Agent collects jobs from it (session type, price,
# paid status) and sends alerts to staff phones through it.
NOVA_WORKER_URL=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev
# The same value as the worker's AGENT_NOVA_KEY secret. Blank = no jobs, alerts only logged.
AGENT_NOVA_KEY=
# Nova Agent waits on the worker for each job (picked up within about a
# second). If the worker answers at once instead, it asks again after this long.
JOBS_EVERY_SECONDS=10

# Longest pause before each click or typed box (ms). 0 = flat out.
ACTION_PAUSE_MS=150

# How many sessions Novabot may book for one website visitor a day.
# A number (default 2, stops abuse) or "unlimited". Restart Nova Agent after changing.
BOOKINGS_PER_VISITOR_PER_DAY=2

# When the daily read-only healthcheck runs (cron format, UK time)
HEALTHCHECK_CRON=0 6 * * *

HEADLESS=true
# When true, never clicks the final confirm button
DRY_RUN=true

# Local visualizer page (npm run visualizer)
VISUALIZER_PORT=4545

# Who uses this Nova Agent, for Nova Index (their own staff memory). One id per person.
NOVA_STAFF_ID=owner

# Optional: keep data somewhere else (e.g. a preview or sample-data copy), never the real data/
# NOVA_DATA_DIR=/path/to/sample-data
