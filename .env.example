# Copy this file to .env and fill it in. Never commit .env.

ANTHROPIC_API_KEY=
# A current Claude model name, e.g. claude-sonnet-5-5
NOVA_MODEL=

# Nova Bot's worker: Nova Agent checks in with it (quest taps from Portal, when the studio's
# bookings changed), reads the studio's bookings and sends alerts to staff phones through it.
NOVA_WORKER_URL=https://nova.novacane.co.uk
# The same value as the worker's AGENT_NOVA_KEY secret. Blank = no bookings, alerts only logged.
AGENT_NOVA_KEY=
# Nova Agent waits on the worker for news (picked up within about a second). If the worker
# answers at once instead, it asks again after this long.
JOBS_EVERY_SECONDS=10

# The studio's timezone ("today", timed jobs and the times Nova Agent shows)
STUDIO_TIMEZONE=Europe/London

# How many sessions Novabot may book for one website visitor a day.
# A number (default 2, stops abuse) or "unlimited". Restart Nova Agent after changing.
BOOKINGS_PER_VISITOR_PER_DAY=2

# Local visualizer page (npm run visualizer)
VISUALIZER_PORT=4545

# Who uses this Nova Agent, for Index (their own staff memory) and its Nova Agent badge.
# Leave it out: Nova Agent picks the studio's first Nova Agent admin by itself, and anyone can
# switch it to themselves with "Connect as me" on the badge. Set it only to force someone.
# NOVA_STAFF_ID=

# Optional: keep data somewhere else (e.g. a preview or sample-data copy), never the real data/
# NOVA_DATA_DIR=/path/to/sample-data
