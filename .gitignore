# Dependencies
node_modules

# Secrets: only .env.example (empty values) is shared
.env
.env.*
!.env.example

# Everything Nova Agent writes at run time: logs with client names, screenshots,
# quests, the copy of the studio's bookings and alerts. Never commit it.
data/
*.log
*.jsonl

# Browser state, traces and captures
storageState*.json
session*.json
user-data/
.chromium-profile/
playwright-report/
test-results/
traces/
*.trace.zip
*.har
screenshots/

# Local editor workspace (points at other local folders)
*.code-workspace
.vscode/
.idea/
.DS_Store

# The Observatory panel's own catalogue of your projects, and what's made from it
# (names, paths, folder trees, screenshots): local only
scripts/observatory/projects.config.json
web/observatory/media/
.phone-check/
